---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    title: "Neural Network Evolutionary Simulator",
    description: "Pygame-based simulation environment controlled by NEAT-Python, visualizing chromosome weights and coin-seeking fitness functions in real-time.",
    tags: ["Python", "Pygame", "NEAT", "Neural Networks"],
    githubUrl: "https://github.com/anton02tran",
  },
  {
    title: "Abakit: Mobile Mental Math Problems",
    description: "Cross-platform mobile application designed to sharpen rapid mental arithmetic calculations through timed exercises and persistent score tracking.",
    tags: ["React Native", "Expo", "JavaScript"],
    githubUrl: "https://github.com/anton02tran",
  }
];
---

<Layout title="Anton Tran | Portfolio">
  <main class="max-w-4xl mx-auto px-6 py-16 space-y-20">
    
    <!-- Hero Section -->
    <section class="space-y-6 pt-12">
      <div class="inline-block rounded-full bg-cyan-950/80 px-3 py-1 text-xs font-mono text-cyan-400 border border-cyan-800/50">
        Software & Hardware Projects
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
        Anton Tran
      </h1>
      <p class="text-xl text-cyan-400 font-mono">
        Building software, embedded systems, & interactive tools.
      </p>
      <p class="text-lg text-zinc-400 max-w-2xl leading-relaxed">
        Passionate about full-stack logic, algorithmic simulations, and microcontrollers. Exploring the overlap between clean code and physical hardware.
      </p>
      <div class="flex flex-wrap gap-4 pt-2">
        <a 
          href="#projects" 
          class="rounded-lg bg-cyan-500 px-5 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-cyan-400"
        >
          View Projects
        </a>
        <a 
          href="https://github.com/anton02tran" 
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-zinc-700 bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-zinc-200 transition hover:bg-zinc-800 hover:border-zinc-600"
        >
          GitHub Profile
        </a>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="space-y-8">
      <div class="flex items-center justify-between border-b border-zinc-800 pb-4">
        <h2 class="text-2xl font-bold tracking-tight text-white">Featured Projects</h2>
        <span class="text-xs font-mono text-zinc-500">Selected Works</span>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </section>

  </main>
</Layout>